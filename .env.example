SERVER_HOST=localhost
SERVER_PORT=1010

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_SCHEMA=public
DB_USER=your_db_user
DB_PASS=your_db_password

DB_REDIS_HOST=localhost
DB_REDIS_PORT=6379
DB_REDIS_PASSWORD=your_redis_password
DB_REDIS_NAME=2

JWT_KEY=your_jwt_secret
JWT_ISSUER=your_app
JWT_AUDIENCE=your_app_users
JWT_EXP=1440

# rate limit global endpoint /api (per IP, window dalam menit). Default: 300 request/menit.
RATE_LIMIT_MAX=300
RATE_LIMIT_EXP=1

# dipakai website game eksternal buat panggil /api/public/* (header X-API-KEY)
PUBLIC_API_KEY=your_public_api_key

# notifikasi Telegram kalau ada server error (500) — buat bot lewat @BotFather di Telegram,
# ChatID bisa didapat dari https://api.telegram.org/bot<TOKEN>/getUpdates setelah kirim pesan
# ke bot-nya. Kosongkan kalau belum mau pakai fitur ini (otomatis di-skip, gak error).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
